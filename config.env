# This env file controls some parameters of the build/test system

OUTPUT := build
ifeq ($(OS),Windows_NT)
DISK   := ..\dsk
else
DISK   := ../dsk
endif

CC := sdcc
AS := sdasz80
AR := sdar
CFLAGS := -mz80 --Werror -I./inc -I.. --opt-code-speed $(EXTRA_CFLAGS)
LDFLAGS :=  -L$(OUTPUT) --no-std-crt0

SOURCES_Z80 := $(wildcard src/*.z80)
OBJS_Z80 := $(patsubst src/%.z80,$(OUTPUT)/%.rel,$(SOURCES_Z80))

SOURCES_C := $(wildcard src/*.c)
OBJS_C := $(patsubst src/%.c,$(OUTPUT)/%.rel,$(SOURCES_C))
